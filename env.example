# =============================================================================
# tweetpy / Dr_G_X_bot — environment template
# Copy to .env for local use. On Render, set these in the service Environment.
# Prefer DATABASE_URL from the Render Postgres add-on over DB_HOST/DB_*.
# =============================================================================

# --- Admin dashboard login (required) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
FLASK_SECRET_KEY=change-this-secret-key-in-production
CRON_SECRET=another-long-random-secret

# --- App runtime ---
# PORT is set automatically by Render; default locally is 5001
# PORT=5001
FLASK_DEBUG=false

# --- X (Twitter) API ---
X_CONSUMER_KEY=your_consumer_key_here
X_CONSUMER_SECRET=your_consumer_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here
X_BEARER_TOKEN=your_bearer_token_here

# --- AI providers (enable at least one) ---
AI_PROVIDER=gemini
AI_PROMPT_PROFILE=web3
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Telegram man-in-the-loop ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
MITL_ENABLED=true
# Compose: photo + tip (or album) → AI expands tip into a draft for Approve/Rewrite

# --- Media library ---
MEDIA_UPLOAD_DIR=media/uploads

# --- Safety / rate budgets ---
SAFETY_ENABLED=true
DAILY_POST_LIMIT=30
MONTHLY_POST_LIMIT=400

# --- PostgreSQL ---
# Render (recommended): leave DB_* blank and use DATABASE_URL from the Postgres add-on
# DATABASE_URL=postgresql://user:pass@host:5432/twitter
# DB_SSLMODE=require

# Local discrete connection (used when DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=twitter
# DB_SSLMODE=prefer
