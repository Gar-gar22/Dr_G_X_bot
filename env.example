# Admin dashboard login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
FLASK_SECRET_KEY=change-this-secret-key-in-production
CRON_SECRET=another-long-random-secret

# X (Twitter) API Credentials
X_CONSUMER_KEY=your_consumer_key_here
X_CONSUMER_SECRET=your_consumer_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here
X_BEARER_TOKEN=your_bearer_token_here

# AI providers (enable at least one)
AI_PROVIDER=gemini
AI_PROMPT_PROFILE=web3
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram man-in-the-loop (approve/edit/reject drafts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
# MITL_ENABLED=true
# Telegram compose: send photo + tip caption → AI expands tip into full post draft

# Media library (dashboard image uploads)
# MEDIA_UPLOAD_DIR=media/uploads

# Safety / rate budgets (optional overrides)
# SAFETY_ENABLED=true
# DAILY_POST_LIMIT=30
# MONTHLY_POST_LIMIT=400

# MySQL Database Configuration
# If your MySQL has no password, leave DB_PASSWORD empty
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=twitter
